# Copy to .env (ignored). Safe default: fresh owned dummy, loopback UI.
# Linux host networking; choose this SERVER's specific192.168 interface for LAN.
FINDER_MODE=dummy
FINDER_LISTEN_HOST=127.0.0.1
FINDER_WEB_PORT=8000
FINDER_LAN_NETWORK=192.168.0.0/16

# Slicing override needs trusted self-contained profiles copied separately.
# Private Finder profiles are NOT distributed in Git or Docker images.
FINDER_PROFILE_DIR=./local-profiles/finder-offline-03

# For real workflow set MODE=proxy and enable only deliberate capabilities.
# Job controls make the browser's default-checked Save + start option available.
FINDER_ENABLE_UPLOAD=false
FINDER_ENABLE_JOB_CONTROLS=false
FINDER_ALLOW_SLICED_UPLOAD=false
FINDER_ENABLE_MONITOR=false
# true opens status connection on every server/container startup; never prints.
FINDER_AUTO_MONITOR=false
FINDER_PROXY_PORT=9000

# Bundled optional printer proxy only (--profile printer).
# Verify the actual printer IP; no discovery, no default hardware selection.
FINDER_PRINTER_HOST=
FINDER_PRINTER_PORT=8899
FINDER_ALLOW_HARDWARE=false

FINDER_STORAGE_MIB=256
FINDER_AUTO_ARCHIVE=true
