# REAL FINDER workflow: copy to .env, set the printer IP below, then:
# podman compose up --build -d    (or docker compose up --build -d)
# Bundled proxy + Orca/Finder2 profiles + web. No separate proxy command/profile.
# Linux x86_64 only; do not also run a host proxy on port9000.
COMPOSE_FILE=docker-compose.yml:compose.live.yml
COMPOSE_PROFILES=printer

# REQUIRED: deliberately verified literal printer IP. No discovery/guessed target.
# Network addresses/passwords stay in your ignored .env, not this public template.
FINDER_PRINTER_HOST=
FINDER_PRINTER_PORT=8899
FINDER_ALLOW_HARDWARE=true
FINDER_MODE=proxy
FINDER_PROXY_PORT=9000

# Local browser: keep127.0.0.1. Other computer: set THIS SERVER's specific192.168
# interface IP (not the printer IP). LAN mode requires login finder + random
# password printed in logs each restart. HTTP is unencrypted; trusted LAN only.
FINDER_LISTEN_HOST=127.0.0.1
FINDER_WEB_PORT=8000
FINDER_LAN_NETWORK=192.168.0.0/16

# Full existing workflow. Save's start-after-upload checkbox defaults checked:
# Save + start can heat/move; uncheck for save only. No page-load/Slice/GX starts.
FINDER_ENABLE_UPLOAD=true
FINDER_ENABLE_JOB_CONTROLS=true
FINDER_ALLOW_SLICED_UPLOAD=true
FINDER_ENABLE_MONITOR=true
# Status-only connection on startup, AFTER bundled proxy listener is healthy.
# Close FlashPrint/other control clients. Stop polling is not print cancel.
FINDER_AUTO_MONITOR=true

FINDER_STORAGE_MIB=256
FINDER_AUTO_ARCHIVE=true
